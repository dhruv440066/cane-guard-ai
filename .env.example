# Port to listen on (Render sets this dynamically)
PORT=8000

# Model confidence threshold (0.00 to 1.00)
CONF_THRESHOLD=0.70

# Max file upload size in Megabytes
MAX_UPLOAD_MB=8

# Green vegetation pixel fraction heuristic (0.00 to 1.00)
MIN_GREEN_FRACTION=0.15

# Allowed CORS origins (comma-separated or * for all)
CORS=*

# Optional: Path to custom persistent data directory (for SQLite DB and uploads)
# DATA_DIR=/var/data

# Optional: Frontend API Base URL (only needed if frontend is hosted separately from backend)
# VITE_API_URL=https://your-backend-app.onrender.com
